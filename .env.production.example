APP_NAME="Fibermedia Ops"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ops.fibermedia.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=fibermedia_ops
DB_USERNAME=fibermedia_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Redis & Broadcasting
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="ops.fibermedia.id"
REVERB_PORT=443
REVERB_SCHEME="https"

# Telescope MUST be disabled in production
TELESCOPE_ENABLED=false

# Sanctum PWA Token Expiration (12 Hours)
SANCTUM_TOKEN_EXPIRATION=720

# VAPID Keys for Web Push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noc@fibermedia.id"
